# TRYBE environment variables — copy to .env.local and fill in.
# Get the Supabase values from: Supabase dashboard -> Project Settings -> API

# Public (safe to expose to the browser; data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — NEVER expose to the browser. Bypasses RLS; used by backend
# jobs (research ingestion, Stripe webhooks) only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (added in the subscriptions milestone — placeholders for now)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
